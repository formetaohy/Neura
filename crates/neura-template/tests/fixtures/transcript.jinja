{%- macro body(content, depth=0) -%}
{%- if content is string -%}
{{- content -}}
{%- elif content is iterable and content is not mapping -%}
{%- for item in content -%}
{%- if 'text' in item -%}
{{- item.text -}}
{%- elif 'picture' in item -%}
{{- raise_exception('a transcript holds text') -}}
{%- else -%}
{{- item | tojson -}}
{%- endif -%}
{%- endfor -%}
{%- elif content is none or content is undefined -%}
{{- '' -}}
{%- else -%}
{{- raise_exception('a body holds text') -}}
{%- endif -%}
{%- endmacro -%}
{%- if not messages -%}
{{- raise_exception('a transcript holds a message') -}}
{%- endif -%}
{%- set ns = namespace(question=messages|length - 1, counted=false) -%}
{%- for message in messages[::-1] -%}
{%- if not ns.counted and message.role == 'user' -%}
{%- set held = body(message.content)|trim -%}
{%- if not (held.startswith('[') and held.endswith(']')) -%}
{%- set ns.counted = true -%}
{%- set ns.question = (messages|length - 1) - loop.index0 -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if not ns.counted -%}
{{- raise_exception('a transcript holds a question') -}}
{%- endif -%}
{%- set tone = 'many' if messages|length > 2 else 'few' -%}
{{- 'tone: ' + tone + '
' -}}
{%- for message in messages -%}
{%- set text = body(message.content, 1)|trim -%}
{%- if message.role == 'system' -%}
{%- if not loop.first -%}
{{- raise_exception('the rules open the transcript') -}}
{%- endif -%}
{{- '<rules>' + text + '</rules>' + '
' -}}
{%- elif message.role == 'user' -%}
{{- 'user ' + loop.index|string + ': ' + text + '
' -}}
{%- elif message.role == 'assistant' -%}
{%- set thought = '' -%}
{%- if message.thought is string -%}
{%- set thought = message.thought -%}
{%- elif '<<' in text -%}
{%- set thought = text.split('<<')[0].rstrip('
') -%}
{%- set text = text.split('<<')[-1].lstrip('
') -%}
{%- endif -%}
{%- set thought = thought|trim -%}
{%- if loop.index0 > ns.question -%}
{{- 'aside[' ~ thought ~ '] ' + text + '
' -}}
{%- else -%}
{{- text + '
' -}}
{%- endif -%}
{%- elif message.role == 'note' -%}
{%- if loop.previtem and loop.previtem.role != 'note' -%}
{{- 'notes: ' -}}
{%- endif -%}
{{- text -}}
{%- if loop.last or loop.nextitem.role != 'note' -%}
{{- ';
' -}}
{%- endif -%}
{%- else -%}
{{- raise_exception('a role no transcript knows') -}}
{%- endif -%}
{%- endfor -%}
{%- if answer_thinking is defined and answer_thinking is true -%}
{{- 'aside ' -}}
{%- else -%}
{{- 'aside (none) ' -}}
{%- endif -%}
